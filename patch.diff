+    function renderVoice(kind, bus, f, p, secPatch, secs = 1.2, durBeats = 1.0) {
+      const sr = 44100;
+      const core = new D.Core(sr, { warm: false });
+      const sec = new Float64Array(D.PSTRIDE);
