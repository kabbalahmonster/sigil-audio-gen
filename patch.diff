+      sec[D.PA.AARP] = secPatch.aArp ?? 0.5;
+      sec[D.PA.ECHO] = secPatch.aSpace ?? 0;
+      sec[D.PA.DRUMS] = 1;
+      sec[D.PA.BITS] = 16; sec[D.PA.HOLD] = 1; sec[D.PA.DBITS] = 16; sec[D.PA.DHOLD] = 1;
+      const ev = new Float64Array(D.STRIDE);
